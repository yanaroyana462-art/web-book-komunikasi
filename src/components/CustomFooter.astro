---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default {...Astro.props} />

<div class="custom-footer-link">
  <a href="/referensi/">📖 Lihat Referensi & Daftar Pustaka</a>
</div>

<style>
  .custom-footer-link {
    text-align: center;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--sl-color-hairline);
  }
  .custom-footer-link a {
    color: var(--sl-color-accent-high);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
  }
  .custom-footer-link a:hover {
    text-decoration: underline;
  }
</style>