---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Footer.astro';
import { Icon } from '@astrojs/starlight/components';
---

<Default {...Astro.props} />

<footer class="custom-footer">
  <div class="footer-container">
    <div class="footer-section">
      <h4>Navigasi</h4>
      <nav>
        <a href="/pengantar">Pengantar</a>
        <a href="/bab-1-qaulan-sadida">Bab Terbaru</a>
        <a href="https://github.com/yanaroyana462/my-book-komunikasi">Kontribusi</a>
      </nav>
    </div>

    <div class="footer-section">
      <h4>Ikuti Kami</h4>
      <div class="social-icons">
        <a href="https://github.com" aria-label="GitHub"><Icon name="github" size="1.5rem" /></a>
        <a href="https://twitter.com" aria-label="Twitter"><Icon name="twitter" size="1.5rem" /></a>
        <a href="https://youtube.com" aria-label="YouTube"><Icon name="youtube" size="1.5rem" /></a>
      </div>
    </div>
  </div>
  
  <div class="footer-bottom">
    <p>© {new Date().getFullYear()} Komunikasi Efektif ala Nabi. Dibuat dengan Starlight.</p>
  </div>
</footer>

<style>
  .custom-footer {
    margin-top: 3rem;
    padding: 2rem 0;
    border-top: 1px solid var(--sl-color-gray-5);
  }
  .footer-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
  }
  .footer-section h4 {
    margin-bottom: 1rem;
    color: var(--sl-color-white);
  }
  .footer-section nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .social-icons {
    display: flex;
    gap: 1rem;
  }
  .footer-bottom {
    margin-top: 2rem;
    text-align: center;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>