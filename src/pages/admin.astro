---
// src/pages/admin.astro
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - Web Buku Komunikasi</title>
  <style>
    /* Reset & Theme Modern Dark */
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif; }
    body { background-color: #0f172a; color: #f8fafc; min-height: 100vh; display: flex; flex-direction: column; align-items: center; padding: 2rem 1rem; }
    
    /* Login Card */
    .login-card { background: #1e293b; border: 1px solid #334155; border-radius: 1rem; padding: 2.5rem; width: 100%; max-width: 400px; margin-top: 4rem; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.5); }
    .login-card h1 { color: #10b981; font-size: 1.5rem; text-align: center; font-weight: 700; margin-bottom: 0.25rem; }
    .login-card p { color: #94a3b8; font-size: 0.85rem; text-align: center; margin-bottom: 1.5rem; }
    .form-group { margin-bottom: 1rem; }
    .form-group label { display: block; font-size: 0.8rem; font-weight: 600; color: #cbd5e1; margin-bottom: 0.4rem; }
    .form-group input { width: 100%; background: #0f172a; border: 1px solid #334155; border-radius: 0.5rem; padding: 0.6rem 0.8rem; color: #fff; font-size: 0.9rem; outline: none; }
    .form-group input:focus { border-color: #10b981; }
    
    /* Dashboard & Table */
    .dashboard { width: 100%; max-width: 1000px; display: none; flex-direction: column; gap: 1.5rem; }
    .header { background: #1e293b; border: 1px solid #334155; border-radius: 1rem; padding: 1.5rem; display: flex; justify-space-between; justify-content: space-between; align-items: center; }
    .header h1 { font-size: 1.25rem; color: #fff; }
    .header p { font-size: 0.8rem; color: #94a3b8; margin-top: 0.2rem; }
    .header span { color: #34d399; font-family: monospace; }
    
    .table-container { background: #1e293b; border: 1px solid #334155; border-radius: 1rem; overflow: hidden; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.3); }
    table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem; }
    th { background: #0f172a; color: #94a3b8; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 1rem; border-bottom: 1px solid #334155; }
    td { padding: 1rem; border-bottom: 1px solid #334155; color: #cbd5e1; }
    tr:hover { background: rgba(51, 65, 85, 0.4); }
    
    /* Buttons & Badges */
    .btn { cursor: pointer; border: none; border-radius: 0.5rem; font-weight: 600; padding: 0.5rem 1rem; font-size: 0.85rem; transition: all 0.2s; }
    .btn-primary { background: #059669; color: white; width: 100%; margin-top: 0.5rem; }
    .btn-primary:hover { background: #10b981; }
    .btn-logout { background: #334155; color: #f1f5f9; }
    .btn-logout:hover { background: #475569; }
    
    .btn-toggle-active { background: #059669; color: white; padding: 0.35rem 0.75rem; font-size: 0.75rem; }
    .btn-toggle-active:hover { background: #10b981; }
    .btn-toggle-deactive { background: #d97706; color: white; padding: 0.35rem 0.75rem; font-size: 0.75rem; }
    .btn-toggle-deactive:hover { background: #f59e0b; }
    .btn-delete { background: #dc2626; color: white; padding: 0.35rem 0.75rem; font-size: 0.75rem; }
    .btn-delete:hover { background: #ef4444; }
    
    .badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; }
    .badge-active { background: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.4); }
    .badge-deactive { background: rgba(245, 158, 11, 0.2); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.4); }
    
    .wa-link { color: #34d399; text-decoration: none; font-weight: 500; }
    .wa-link:hover { text-decoration: underline; }
    
    .error-box { background: rgba(225, 29, 72, 0.2); border: 1px solid #f43f5e; color: #fecdd3; font-size: 0.8rem; padding: 0.6rem; border-radius: 0.5rem; margin-bottom: 1rem; text-align: center; display: none; }
    .actions { display: flex; gap: 0.5rem; justify-content: center; }
  </style>
</head>
<body>

  <!-- LOGIN CONTAINER -->
  <div id="admin-login-card" class="login-card">
    <h1>Login Admin</h1>
    <p>Akses khusus pengelola web</p>
    
    <div id="login-error" class="error-box"></div>

    <form id="admin-login-form">
      <div class="form-group">
        <label>Email Admin</label>
        <input type="email" id="admin-email" required placeholder="admin@domain.com">
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" id="admin-password" required placeholder="••••••••">
      </div>
      <button type="submit" class="btn btn-primary">Masuk Dashboard</button>
    </form>
  </div>

  <!-- DASHBOARD CONTAINER -->
  <div id="admin-dashboard" class="dashboard">
    <div class="header">
      <div>
        <h1>Kelola Pendaftar E-Book</h1>
        <p>Admin terhubung: <span id="current-admin-email"></span></p>
      </div>
      <button id="btn-logout" class="btn btn-logout">Keluar (Logout)</button>
    </div>

    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>Nama Lengkap</th>
            <th>No. WhatsApp</th>
            <th>Email</th>
            <th>Status Akses</th>
            <th style="text-align: center;">Aksi (Kontrol)</th>
          </tr>
        </thead>
        <tbody id="user-table-body">
          <tr>
            <td colspan="5" style="text-align: center; color: #64748b; padding: 2rem;">Memuat data pendaftar...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- SCRIPT FIREBASE -->
  <script>
    import { initializeApp } from "firebase/app";
    import { 
      getAuth, 
      signInWithEmailAndPassword, 
      onAuthStateChanged, 
      signOut 
    } from "firebase/auth";
    import { 
      getFirestore, 
      collection, 
      onSnapshot, 
      doc, 
      updateDoc, 
      deleteDoc 
    } from "firebase/firestore";

    const firebaseConfig = {
      apiKey: "AIzaSyCg6eupoPoUVVdMcmFBdA4P8XomPOn019U",
      authDomain: "landing-page-web-komunikasi.firebaseapp.com",
      projectId: "landing-page-web-komunikasi",
      storageBucket: "landing-page-web-komunikasi.firebasestorage.app",
      messagingSenderId: "614908449393",
      appId: "1:614908449393:web:632c82619784d69ed1c1d0",
      measurementId: "G-7BKSRYT2JG"
    };

    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);
    const db = getFirestore(app);

    const ADMIN_EMAILS = [
      "yanaroyana462@gmail.com",
    ];

    const loginCard = document.getElementById("admin-login-card");
    const dashboard = document.getElementById("admin-dashboard");
    const loginForm = document.getElementById("admin-login-form");
    const loginError = document.getElementById("login-error");
    const btnLogout = document.getElementById("btn-logout");
    const userTableBody = document.getElementById("user-table-body");
    const currentAdminEmail = document.getElementById("current-admin-email");

    loginForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if(loginError) loginError.style.display = "none";
      
      const email = (document.getElementById("admin-email") as HTMLInputElement).value.trim();
      const password = (document.getElementById("admin-password") as HTMLInputElement).value;

      try {
        const userCredential = await signInWithEmailAndPassword(auth, email, password);
        if (!ADMIN_EMAILS.includes(userCredential.user.email || "")) {
          await signOut(auth);
          showError("Akses ditolak. Email Anda bukan akun Admin.");
        }
      } catch (err: any) {
        showError("Gagal login: " + (err.message || "Email atau password salah."));
      }
    });

    btnLogout?.addEventListener("click", () => signOut(auth));

    onAuthStateChanged(auth, (user) => {
      if (user && ADMIN_EMAILS.includes(user.email || "")) {
        if(loginCard) loginCard.style.display = "none";
        if(dashboard) dashboard.style.display = "flex";
        if (currentAdminEmail) currentAdminEmail.textContent = user.email || "";
        loadUsersRealtime();
      } else {
        if(dashboard) dashboard.style.display = "none";
        if(loginCard) loginCard.style.display = "block";
      }
    });

    function showError(msg: string) {
      if (loginError) {
        loginError.textContent = msg;
        loginError.style.display = "block";
      }
    }

    function loadUsersRealtime() {
      const usersRef = collection(db, "users");
      
      onSnapshot(usersRef, (snapshot) => {
        if (snapshot.empty) {
          if (userTableBody) {
            userTableBody.innerHTML = `<tr><td colspan="5" style="text-align: center; color: #64748b; padding: 2rem;">Belum ada pendaftar.</td></tr>`;
          }
          return;
        }

        let html = "";
        snapshot.forEach((userDoc) => {
          const data = userDoc.data();
          const uid = userDoc.id;
          const isVerified = data.isVerified === true;

          html += `
            <tr>
              <td style="font-weight: 600; color: #fff;">${data.name || '-'}</td>
              <td>
                <a href="https://wa.me/${formatWaNumber(data.whatsapp)}" target="_blank" class="wa-link">
                  ${data.whatsapp || '-'}
                </a>
              </td>
              <td style="color: #94a3b8;">${data.email || '-'}</td>
              <td>
                ${
                  isVerified 
                    ? `<span class="badge badge-active">Aktif</span>`
                    : `<span class="badge badge-deactive">Non-Aktif</span>`
                }
              </td>
              <td>
                <div class="actions">
                  <button 
                    onclick="toggleStatus('${uid}', ${!isVerified})"
                    class="btn ${isVerified ? 'btn-toggle-deactive' : 'btn-toggle-active'}"
                  >
                    ${isVerified ? 'Non-Aktifkan' : 'Aktifkan'}
                  </button>
                  <button 
                    onclick="deleteUserRecord('${uid}')"
                    class="btn btn-delete"
                  >
                    Hapus
                  </button>
                </div>
              </td>
            </tr>
          `;
        });

        if (userTableBody) userTableBody.innerHTML = html;
      });
    }

    function formatWaNumber(phone: string) {
      if (!phone) return "";
      let cleaned = phone.replace(/\D/g, '');
      if (cleaned.startsWith('0')) {
        cleaned = '62' + cleaned.slice(1);
      }
      return cleaned;
    }

    (window as any).toggleStatus = async (uid: string, nextStatus: boolean) => {
      try {
        const userRef = doc(db, "users", uid);
        await updateDoc(userRef, { isVerified: nextStatus });
      } catch (err) {
        alert("Gagal mengubah status: " + err);
      }
    };

    (window as any).deleteUserRecord = async (uid: string) => {
      if (confirm("Apakah Anda yakin ingin menghapus pendaftar ini dari Firestore?")) {
        try {
          const userRef = doc(db, "users", uid);
          await deleteDoc(userRef);
        } catch (err) {
          alert("Gagal menghapus data: " + err);
        }
      }
    };
  </script>
</body>
</html>