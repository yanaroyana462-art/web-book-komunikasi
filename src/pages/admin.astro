---
// src/pages/admin.astro
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - Web Buku Komunikasi</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen">

  <!-- CONTAINER LOGIN ADMIN -->
  <div id="admin-login-card" class="max-w-md mx-auto mt-20 p-8 bg-slate-800 rounded-2xl shadow-xl border border-slate-700">
    <h1 class="text-2xl font-bold text-center text-emerald-400 mb-2">Login Admin</h1>
    <p class="text-xs text-slate-400 text-center mb-6">Akses khusus pengelola web</p>
    
    <div id="login-error" class="hidden bg-rose-500/20 border border-rose-500 text-rose-300 text-xs p-3 rounded-lg mb-4 text-center"></div>

    <form id="admin-login-form" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Email Admin</label>
        <input type="email" id="admin-email" required class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500" placeholder="admin@domain.com">
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Password</label>
        <input type="password" id="admin-password" required class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500" placeholder="••••••••">
      </div>
      <button type="submit" id="btn-login" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-semibold py-2 rounded-lg text-sm transition">
        Masuk Dashboard
      </button>
    </form>
  </div>

  <!-- CONTAINER DASHBOARD ADMIN -->
  <div id="admin-dashboard" class="hidden max-w-6xl mx-auto py-10 px-4">
    <div class="flex justify-between items-center mb-8 bg-slate-800 p-6 rounded-2xl border border-slate-700">
      <div>
        <h1 class="text-2xl font-bold text-white">Kelola Pendaftar E-Book</h1>
        <p class="text-xs text-slate-400 mt-1">Admin terhubung: <span id="current-admin-email" class="text-emerald-400 font-mono"></span></p>
      </div>
      <button id="btn-logout" class="bg-slate-700 hover:bg-slate-600 text-slate-200 px-4 py-2 rounded-lg text-xs font-semibold transition">
        Keluar (Logout)
      </button>
    </div>

    <!-- TABEL USER -->
    <div class="bg-slate-800 rounded-2xl border border-slate-700 overflow-hidden shadow-xl">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-300">
          <thead class="bg-slate-900/80 text-xs uppercase text-slate-400 border-b border-slate-700">
            <tr>
              <th class="px-6 py-4">Nama Lengkap</th>
              <th class="px-6 py-4">No. WhatsApp</th>
              <th class="px-6 py-4">Email</th>
              <th class="px-6 py-4">Status Akses</th>
              <th class="px-6 py-4 text-center">Aksi (Kontrol)</th>
            </tr>
          </thead>
          <tbody id="user-table-body" class="divide-y divide-slate-700">
            <tr>
              <td colspan="5" class="px-6 py-8 text-center text-slate-500">Memuat data pendaftar...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    import { initializeApp } from "firebase/app";
    import { 
      getAuth, 
      signInWithEmailAndPassword, 
      onAuthStateChanged, 
      signOut 
    } from "firebase/auth";
    import { 
      getFirestore, 
      collection, 
      onSnapshot, 
      doc, 
      updateDoc, 
      deleteDoc 
    } from "firebase/firestore";

    const firebaseConfig = {
      apiKey: "AIzaSyCg6eupoPoUVVdMcmFBdA4P8XomPOn019U",
      authDomain: "landing-page-web-komunikasi.firebaseapp.com",
      projectId: "landing-page-web-komunikasi",
      storageBucket: "landing-page-web-komunikasi.firebasestorage.app",
      messagingSenderId: "614908449393",
      appId: "1:614908449393:web:632c82619784d69ed1c1d0",
      measurementId: "G-7BKSRYT2JG"
    };

    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);
    const db = getFirestore(app);

    const ADMIN_EMAILS = [
      "yanaroyana462@gmail.com",
    ];

    const loginCard = document.getElementById("admin-login-card");
    const dashboard = document.getElementById("admin-dashboard");
    const loginForm = document.getElementById("admin-login-form");
    const loginError = document.getElementById("login-error");
    const btnLogout = document.getElementById("btn-logout");
    const userTableBody = document.getElementById("user-table-body");
    const currentAdminEmail = document.getElementById("current-admin-email");

    loginForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      loginError?.classList.add("hidden");
      
      const email = (document.getElementById("admin-email") as HTMLInputElement).value.trim();
      const password = (document.getElementById("admin-password") as HTMLInputElement).value;

      try {
        const userCredential = await signInWithEmailAndPassword(auth, email, password);
        if (!ADMIN_EMAILS.includes(userCredential.user.email || "")) {
          await signOut(auth);
          showError("Akses ditolak. Email Anda bukan akun Admin.");
        }
      } catch (err: any) {
        showError("Gagal login: " + (err.message || "Email atau password salah."));
      }
    });

    btnLogout?.addEventListener("click", () => signOut(auth));

    onAuthStateChanged(auth, (user) => {
      if (user && ADMIN_EMAILS.includes(user.email || "")) {
        loginCard?.classList.add("hidden");
        dashboard?.classList.remove("hidden");
        if (currentAdminEmail) currentAdminEmail.textContent = user.email;
        loadUsersRealtime();
      } else {
        dashboard?.classList.add("hidden");
        loginCard?.classList.remove("hidden");
      }
    });

    function showError(msg: string) {
      if (loginError) {
        loginError.textContent = msg;
        loginError.classList.remove("hidden");
      }
    }

    function loadUsersRealtime() {
      const usersRef = collection(db, "users");
      
      onSnapshot(usersRef, (snapshot) => {
        if (snapshot.empty) {
          if (userTableBody) {
            userTableBody.innerHTML = `<tr><td colspan="5" class="px-6 py-8 text-center text-slate-500">Belum ada pendaftar.</td></tr>`;
          }
          return;
        }

        let html = "";
        snapshot.forEach((userDoc) => {
          const data = userDoc.data();
          const uid = userDoc.id;
          const isVerified = data.isVerified === true;

          html += `
            <tr class="hover:bg-slate-700/50 transition">
              <td class="px-6 py-4 font-semibold text-white">${data.name || '-'}</td>
              <td class="px-6 py-4">
                <a href="https://wa.me/${formatWaNumber(data.whatsapp)}" target="_blank" class="text-emerald-400 hover:underline">
                  ${data.whatsapp || '-'}
                </a>
              </td>
              <td class="px-6 py-4 text-slate-400">${data.email || '-'}</td>
              <td class="px-6 py-4">
                ${
                  isVerified 
                    ? `<span class="bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 text-xs px-2.5 py-1 rounded-full font-medium">Aktif</span>`
                    : `<span class="bg-amber-500/20 text-amber-400 border border-amber-500/40 text-xs px-2.5 py-1 rounded-full font-medium">Non-Aktif</span>`
                }
              </td>
              <td class="px-6 py-4 text-center">
                <div class="flex justify-center items-center gap-2">
                  <button 
                    onclick="toggleStatus('${uid}', ${!isVerified})"
                    class="${isVerified ? 'bg-amber-600 hover:bg-amber-500' : 'bg-emerald-600 hover:bg-emerald-500'} text-white text-xs px-3 py-1.5 rounded-lg font-medium transition"
                  >
                    ${isVerified ? 'Non-Aktifkan' : 'Aktifkan'}
                  </button>
                  <button 
                    onclick="deleteUserRecord('${uid}')"
                    class="bg-rose-600/80 hover:bg-rose-600 text-white text-xs px-3 py-1.5 rounded-lg font-medium transition"
                  >
                    Hapus
                  </button>
                </div>
              </td>
            </tr>
          `;
        });

        if (userTableBody) userTableBody.innerHTML = html;
      });
    }

    function formatWaNumber(phone: string) {
      if (!phone) return "";
      let cleaned = phone.replace(/\D/g, '');
      if (cleaned.startsWith('0')) {
        cleaned = '62' + cleaned.slice(1);
      }
      return cleaned;
    }

    (window as any).toggleStatus = async (uid: string, nextStatus: boolean) => {
      try {
        const userRef = doc(db, "users", uid);
        await updateDoc(userRef, { isVerified: nextStatus });
      } catch (err) {
        alert("Gagal mengubah status: " + err);
      }
    };

    (window as any).deleteUserRecord = async (uid: string) => {
      if (confirm("Apakah Anda yakin ingin menghapus pendaftar ini dari Firestore?")) {
        try {
          const userRef = doc(db, "users", uid);
          await deleteDoc(userRef);
        } catch (err) {
          alert("Gagal menghapus data: " + err);
        }
      }
    };
  </script>
</body>
</html>